# Copy this file to .env and fill in your own keys:
#     cp .env.example .env
# .env is gitignored; this file is not. Never put real keys here.

# --- GROQ (required) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LANGSMITH (optional tracing) ---
# Leave tracing false unless you want runs sent to LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-code-debugger

# --- MODEL ---
# Temperature 0 is deliberate: retries feed the previous failure back into the
# prompt, which only works because the model is otherwise deterministic.
MODEL_NAME=openai/gpt-oss-120b
MODEL_TEMPERATURE=0

# --- VECTOR STORE ---
VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./storage/vector_indexes

# --- REPOSITORY STORAGE ---
# Relative paths are resolved against the project root, not the working
# directory, so this points at the same place wherever the process is started.
REPO_STORAGE_ROOT=./storage/repositories

# --- LIMITS ---
MAX_REPOSITORY_SIZE_MB=20
MAX_AGENT_RETRIES=3
CODE_EXECUTION_TIMEOUT=15

# --- SERVER ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- SESSION STORE ---
# Where paused sessions are checkpointed. Must be a sqlite:/// URL.
DATABASE_URL=sqlite:///./debugger.db
